rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null
        && request.auth.token.get(['firebase', 'sign_in_provider'], '') != 'anonymous'
        && (request.auth.token.get('admin', false) == true
          || (request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', '').lower() in ['thomas@tk-design.no', 'knutsenthomas@gmail.com']));
    }
    match /adminProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /graphicDocs/{docId} {
      allow read: if true;
      allow write: if isAdministrator();
    }
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdministrator();
    }
    // Private inbox, scheduler state and administrative documents are server-only.
    match /{document=**} {
      allow read, write: if isAdministrator();
    }
  }
}
